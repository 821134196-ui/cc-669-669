{
  "name": "preorder-batch-allocation",
  "private": true,
  "description": "电商商品预订到货批次分配系统（NestJS + Prisma/SQLite + React）",
  "scripts": {
    "postinstall": "npm --prefix server install && npm --prefix web install",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --prefix server run start:dev",
    "dev:web": "npm --prefix web run dev",
    "test": "npm --prefix server run test",
    "smoke": "node scripts/smoke.mjs",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
